GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Optional. Defaults to gemini-2.5-flash when omitted.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Defaults to 3. Controls browser photo workers and caps Gemini request pressure.
DUMPDECK_ANALYSIS_CONCURRENCY=3
# Optional. Defaults to 70. Only quick-scan candidates are sent to Gemini.
DUMPDECK_MAX_GEMINI_PHOTOS=70

# Optional. Used only by `npm run check:supabase` for staging readiness checks.
FOTOFAIRY_READINESS_EMAIL=confirmed-test-user@example.com
FOTOFAIRY_READINESS_PASSWORD=confirmed-test-user-password

# Optional. Controls the browser-side universal Instagram share/export workflow.
# This does not enable direct Meta API publishing.
VITE_INSTAGRAM_SHARE_ENABLED=true

# Optional. Enables nondestructive photo framing on the final collection screen.
VITE_FINAL_FRAMING_EDITOR_ENABLED=true

# Server-only placeholders for future Instagram Professional direct publishing.
# Do not expose META_APP_SECRET or user tokens to the browser.
INSTAGRAM_DIRECT_PUBLISH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
