GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Optional. Defaults to gemini-2.5-flash when omitted.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Defaults to 3. Controls browser photo workers and caps Gemini request pressure.
DUMPDECK_ANALYSIS_CONCURRENCY=3
# Optional. Defaults to 70. Only quick-scan candidates are sent to Gemini.
DUMPDECK_MAX_GEMINI_PHOTOS=70

# Optional. Used only by `npm run check:supabase` for staging readiness checks.
FOTOFAIRY_READINESS_EMAIL=confirmed-test-user@example.com
FOTOFAIRY_READINESS_PASSWORD=confirmed-test-user-password
